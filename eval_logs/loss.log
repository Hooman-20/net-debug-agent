# Generated by the network debugging agent
# Request: measure speed and packet loss from ns1 to ns2 with 1000 UDP packets
# TYPE: two-sided
# Re-run: python tool_builder.py --run tools/udp_speed_loss_2.py
#!/usr/bin/env python3
"""Two-sided UDP speed + packet-loss test ns1 -> ns2 with 1000 packets."""
import argparse
import socket
import struct
import sys
import time

RECEIVER_IP = "10.0.0.2"
PORT = 5001
DEFAULT_COUNT = 1000
PAYLOAD_BYTES = 1024  # +8 header = 1032 bytes per datagram (<1500 MTU)
HEADER_FMT = "!II"  # seq, total
HEADER_LEN = struct.calcsize(HEADER_FMT)
PACE_SEC = 0.001
RECV_TIMEOUT_FIRST = 10.0
RECV_TIMEOUT_AFTER = 3.0


def run_sender(count):
    dest = (RECEIVER_IP, PORT)
    payload = b"X" * PAYLOAD_BYTES
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.settimeout(5.0)
    # enlarge send buffer (socket option only, not system setting)
    try:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_SNDBUF, 1024 * 1024)
    except OSError:
        pass
    sent = 0
    errors = 0
    total_bytes = 0
    print(f"[sender] target {RECEIVER_IP}:{PORT} count={count} "
          f"packet_size={HEADER_LEN + PAYLOAD_BYTES} pace={PACE_SEC*1000:.1f}ms")
    sys.stdout.flush()
    start = time.monotonic()
    wall_start = time.time()
    try:
        for seq in range(count):
            pkt = struct.pack(HEADER_FMT, seq, count) + payload
            try:
                n = sock.sendto(pkt, dest)
                sent += 1
                total_bytes += n
            except OSError as e:
                errors += 1
                print(f"[sender] sendto seq={seq} error: {e}")
            if seq != count - 1:
                time.sleep(PACE_SEC)
    finally:
        end = time.monotonic()
        wall_end = time.time()
        sock.close()
    dur = end - start
    if dur <= 0:
        dur = 0.000001
    pps = sent / dur
    mbps = total_bytes * 8 / dur / 1e6
    print("=== SENDER RESULT ===")
    print(f"packets_sent: {sent}/{count}")
    print(f"send_errors: {errors}")
    print(f"bytes_sent: {total_bytes}")
    print(f"duration_sec: {dur:.4f}")
    print(f"wall_start: {wall_start:.3f} wall_end: {wall_end:.3f}")
    print(f"send_rate_pps: {pps:.1f}")
    print(f"send_throughput_mbps: {mbps:.3f}")
    print(f"raw_evidence: sent={sent} expected={count} bytes={total_bytes} "
          f"dur={dur:.4f}s pps={pps:.1f} mbps={mbps:.3f}")
    if sent == count and errors == 0:
        print("SENDER_STATUS: DONE (all packets emitted, see receiver for loss)")
    else:
        print("SENDER_STATUS: INCOMPLETE (local send failed)")
    sys.stdout.flush()


def run_receiver():
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.settimeout(RECV_TIMEOUT_FIRST)
    try:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    except OSError:
        pass
    try:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, 4 * 1024 * 1024)
    except OSError:
        pass
    try:
        sock.bind((RECEIVER_IP, PORT))
    except OSError as e:
        print(f"[receiver] bind {RECEIVER_IP}:{PORT} failed: {e}")
        print("=== RECEIVER RESULT ===")
        print("packets_received: 0")
        print("packets_expected: unknown")
        print("loss_percent: 100.0")
        print("throughput_mbps: 0.0")
        print(f"raw_evidence: bind_error={e}")
        print("RESULT: FAIL - could not bind")
        sys.stdout.flush()
        return

    print(f"[receiver] listening on {RECEIVER_IP}:{PORT} "
          f"timeout_first={RECV_TIMEOUT_FIRST}s timeout_after={RECV_TIMEOUT_AFTER}s")
    sys.stdout.flush()
    seen = set()
    expected = DEFAULT_COUNT
    got_expected = False
    bytes_rx = 0
    malformed = 0
    first_t = None
    last_t = None
    wall_first = None
    wall_last = None
    bind_time = time.monotonic()
    try:
        while True:
            try:
                data, addr = sock.recvfrom(65535)
            except socket.timeout:
                # timeout: either nothing arrived (10s) or 3s after last packet
                break
            except OSError as e:
                print(f"[receiver] recv error: {e}")
                break
            now = time.monotonic()
            wall = time.time()
            if first_t is None:
                first_t = now
                wall_first = wall
                # after first packet, shorten timeout to 3s after last
                sock.settimeout(RECV_TIMEOUT_AFTER)
            last_t = now
            wall_last = wall
            bytes_rx += len(data)
            if len(data) < HEADER_LEN:
                malformed += 1
                continue
            seq, total = struct.unpack(HEADER_FMT, data[:HEADER_LEN])
            if not got_expected:
                # trust first valid total; keep max in case of mismatch
                if 0 < total <= 100000:
                    expected = total
                    got_expected = True
            else:
                if total != expected and total > 0:
                    if total > expected:
                        expected = total
            # only count in-range seqs, but keep duplicates info
            seen.add(seq)
            if len(seen) >= expected and expected > 0:
                # wait full 3s grace for late/reordered packets; loop continues
                # until socket.timeout fires
                pass
    finally:
        end_time = time.monotonic()
        sock.close()

    received = len(seen)
    if expected <= 0:
        expected = DEFAULT_COUNT
    missing = expected - received
    if missing < 0:
        missing = 0
    loss_pct = (missing / expected * 100.0) if expected > 0 else 100.0
    if first_t is not None and last_t is not None:
        span = last_t - first_t
        if span < 0.000001:
            span = 0.000001 if received > 1 else 0.0
    else:
        span = 0.0
    if span > 0:
        mbps = bytes_rx * 8 / span / 1e6
        pps = received / span
    else:
        mbps = 0.0
        pps = 0.0
    total_wait = end_time - bind_time

    # missing seq sample for evidence (first 20)
    missing_sample = []
    if expected <= 10000 and received < expected:
        s = set(range(expected))
        miss = sorted(s - seen)[:20]
        missing_sample = miss

    print("=== RECEIVER RESULT ===")
    print(f"packets_received: {received}")
    print(f"packets_expected: {expected}")
    print(f"packets_missing: {missing}")
    print(f"loss_percent: {loss_pct:.2f}")
    print(f"bytes_received: {bytes_rx}")
    print(f"malformed_packets: {malformed}")
    print(f"span_first_last_sec: {span:.4f}")
    print(f"total_listen_sec: {total_wait:.4f}")
    print(f"throughput_mbps: {mbps:.3f}")
    print(f"recv_rate_pps: {pps:.1f}")
    print(f"raw_evidence: received={received} expected={expected} missing={missing} "
          f"loss={loss_pct:.2f}% bytes={bytes_rx} span={span:.4f}s "
          f"listen={total_wait:.4f}s mbps={mbps:.3f} malformed={malformed}")
    if first_t is not None:
        print(f"raw_evidence: wall_first={wall_first:.3f} wall_last={wall_last:.3f}")
    if missing_sample:
        print(f"raw_evidence: missing_sample={missing_sample}")
    if received == 0:
        print("RESULT: FAIL - no packets arrived")
    elif loss_pct == 0.0:
        print("RESULT: PASS - no loss")
    else:
        print(f"RESULT: FAIL - loss detected ({loss_pct:.2f}%)")
    sys.stdout.flush()


def main():
    ap = argparse.ArgumentParser(description="UDP speed/loss test")
    ap.add_argument("--role", required=True, choices=["sender", "receiver"],
                    help="sender runs in ns1, receiver binds 10.0.0.2:5001 in ns2")
    ap.add_argument("--count", type=int, default=DEFAULT_COUNT,
                    help="number of UDP packets (default 1000)")
    ap.add_argument("--port", type=int, default=PORT)
    args = ap.parse_args()
    global PORT
    PORT = args.port
    count = args.count
    if count <= 0 or count > 100000:
        print(f"invalid --count {count}, using {DEFAULT_COUNT}")
        count = DEFAULT_COUNT
    if args.role == "sender":
        run_sender(count)
    else:
        run_receiver()


if __name__ == "__main__":
    main()

