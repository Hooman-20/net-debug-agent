# Generated by the network debugging agent
# Request: find the largest MTU that works from ns1 to ns2
# TYPE: one-sided
# Re-run: python tool_builder.py --run tools/mtu_discovery.py
#!/usr/bin/env python3
"""Find largest MTU that works from ns1 to ns2 via ping with DF bit."""
import subprocess
import sys
import time


TARGET = "10.0.0.2"
PING_TIMEOUT_S = 1  # ping -W value
SUBPROC_TIMEOUT_S = 3  # backstop for subprocess.run
MAX_PAYLOAD = 9000  # to allow detection of jumbo frames; MTU = payload+28
OVERHEAD = 28  # 20 byte IP header + 8 byte ICMP header


def run_ping(payload_size):
    """Ping once with DF set. Returns (success_bool, combined_output, returncode)."""
    args = ["ping", "-c", "1", "-W", str(PING_TIMEOUT_S),
            "-M", "do", "-s", str(payload_size), TARGET]
    start = time.monotonic()
    try:
        proc = subprocess.run(args, capture_output=True, text=True,
                              timeout=SUBPROC_TIMEOUT_S)
        out = (proc.stdout or "") + (proc.stderr or "")
        elapsed = time.monotonic() - start
        return (proc.returncode == 0, out.strip(), proc.returncode, elapsed)
    except subprocess.TimeoutExpired as e:
        out = ""
        if e.stdout:
            out += e.stdout.decode() if isinstance(e.stdout, bytes) else str(e.stdout)
        if e.stderr:
            out += e.stderr.decode() if isinstance(e.stderr, bytes) else str(e.stderr)
        elapsed = time.monotonic() - start
        return (False, ("TIMEOUT after %.2fs " % elapsed) + out.strip(), 124, elapsed)
    except FileNotFoundError as e:
        elapsed = time.monotonic() - start
        return (False, "ping tool not found: %s" % e, 127, elapsed)
    except Exception as e:
        elapsed = time.monotonic() - start
        return (False, "error running ping: %r" % e, 1, elapsed)


def summary_line(output):
    """Extract summary-ish lines for raw evidence."""
    lines = []
    for line in output.splitlines():
        s = line.strip()
        if not s:
            continue
        # keep transmitted/received line, errors, Frag needed, etc.
        lines.append(s)
    # keep last 4 lines max to avoid huge dumps on large payloads
    if len(lines) > 6:
        return "\n".join(lines[:2] + ["..."] + lines[-3:])
    return "\n".join(lines)


def read_local_mtus():
    """Best-effort read of local interface MTUs via sysfs (read-only)."""
    import os
    import glob
    info = {}
    try:
        for p in glob.glob("/sys/class/net/*/mtu"):
            try:
                with open(p, "r") as f:
                    val = f.read().strip()
                # p like /sys/class/net/veth1/mtu -> iface veth1
                parts = p.split("/")
                iface = parts[4] if len(parts) > 4 else p
                info[iface] = val
            except Exception:
                continue
    except Exception:
        pass
    return info


def main():
    t0 = time.monotonic()
    print("MTU discovery test (one-sided)")
    print("TARGET: %s" % TARGET)
    print("METHOD: ping -M do -s <payload> (DF set), MTU = payload+%d" % OVERHEAD)
    mtus = read_local_mtus()
    if mtus:
        print("LOCAL interface MTUs (from /sys, read-only): %s" % mtus)
    else:
        print("LOCAL interface MTUs: unavailable")

    # Step 1: check basic connectivity with small packet (payload 0 and 56 default-ish)
    print("\n--- baseline connectivity ---")
    base_ok = False
    base_out = ""
    for base_payload in (0, 56):
        ok, out, rc, dt = run_ping(base_payload)
        print("BASELINE payload=%d success=%s rc=%s time=%.3fs" % (base_payload, ok, rc, dt))
        print("RAW:")
        print(summary_line(out) if out else "(no output)")
        if ok:
            base_ok = True
            base_out = out
            break
    if not base_ok:
        print("\nRESULT: FAIL - no ping connectivity to %s even with tiny packets" % TARGET)
        print("LARGEST_MTU: unknown (no connectivity)")
        print("EVIDENCE baseline payload 0/56 both failed, see RAW above")
        print("TOTAL_TIME: %.2fs" % (time.monotonic() - t0))
        return 0

    # Step 2: binary search for max payload in [0, MAX_PAYLOAD]
    print("\n--- binary search payload in [0,%d] ---" % MAX_PAYLOAD)
    # quick check top end first for logging
    low = 0  # known good (baseline proved 0 or 56 works; ensure low is good)
    # ensure low is actually good: if baseline 56 worked but 0 somehow fails, fix low
    ok0, _, _, _ = run_ping(0) if base_payload != 0 else (True, "", 0, 0)
    # we already know at least one small size works; set low to largest known good small
    if ok0:
        low = 0
        # verify 0 good, else keep 56? Actually 0 should work if 56 works, but be safe
    else:
        low = 56
    high = MAX_PAYLOAD
    # if low==56, we need to confirm 56 good (it was). ok.
    n_probes = 0
    # binary search invariant: low is good, high may be good or bad; find max good <= MAX_PAYLOAD
    # first test high to know if everything passes
    ok_high, out_high, rc_high, dt_high = run_ping(high)
    print("PROBE payload=%d success=%s rc=%s time=%.3fs" % (high, ok_high, rc_high, dt_high))
    print("RAW:")
    print(summary_line(out_high) if out_high else "(no output)")
    n_probes += 1
    # enforce overall time budget: stop if >20s elapsed
    if ok_high:
        best_payload = high
    else:
        # binary search between low (good) and high (bad)
        lo = low
        hi = high  # hi is bad
        best_payload = lo
        while lo + 1 < hi:
            if (time.monotonic() - t0) > 20:
                print("TIME BUDGET: stopping search early at lo=%d hi=%d" % (lo, hi))
                break
            mid = (lo + hi + 1) // 2
            # alternative mid calc for upper-mid binary search: (lo+hi+1)//2 with lo good hi bad
            # but to keep invariant lo good hi bad, use mid = (lo+hi)//2 ; if good lo=mid else hi=mid
            # adjust: use (lo+hi)//2
            mid = (lo + hi) // 2
            if mid == lo or mid == hi:
                break
            ok, out, rc, dt = run_ping(mid)
            print("PROBE payload=%d success=%s rc=%s time=%.3fs" % (mid, ok, rc, dt))
            print("RAW:")
            print(summary_line(out) if out else "(no output)")
            n_probes += 1
            if ok:
                lo = mid
            else:
                hi = mid
            best_payload = lo
            # safety: limit probes to ~14
            if n_probes > 16:
                break
        best_payload = lo

    best_mtu = best_payload + OVERHEAD
    print("\n--- verification ---")
    # verify best and best+1 (if in range)
    ok_best, out_best, rc_best, dt_best = run_ping(best_payload)
    print("VERIFY payload=%d (MTU=%d) success=%s rc=%s time=%.3fs" % (best_payload, best_mtu, ok_best, rc_best, dt_best))
    print("RAW:")
    print(summary_line(out_best) if out_best else "(no output)")
    if best_payload < MAX_PAYLOAD:
        nxt = best_payload + 1
        ok_nxt, out_nxt, rc_nxt, dt_nxt = run_ping(nxt)
        print("VERIFY payload=%d (MTU=%d) success=%s rc=%s time=%.3fs" % (nxt, nxt + OVERHEAD, ok_nxt, rc_nxt, dt_nxt))
        print("RAW:")
        print(summary_line(out_nxt) if out_nxt else "(no output)")
    else:
        ok_nxt = False
        nxt = None

    print("\n=== RESULT ===")
    print("TARGET: %s" % TARGET)
    print("LARGEST_PAYLOAD: %d bytes (ping -s)" % best_payload)
    print("LARGEST_MTU: %d bytes (payload+%d)" % (best_mtu, OVERHEAD))
    print("PROBES: %d (+2 verify)" % n_probes)
    if best_payload == MAX_PAYLOAD and ok_high:
        print("NOTE: payload %d still works; true MTU >= %d (jumbo or larger)" % (MAX_PAYLOAD, best_mtu))
    elif best_payload >= 1472 and best_payload < MAX_PAYLOAD:
        # typical 1500 MTU case
        print("NOTE: 1472 payload (1500 MTU) works; next size fails as expected for 1500 MTU" if best_payload == 1472 else "NOTE: largest working MTU is %d" % best_mtu)
    print("EVIDENCE: verify MTU=%d %s, MTU=%d %s (see RAW above)" % (
        best_mtu, "PASS" if ok_best else "FAIL",
        (nxt + OVERHEAD) if nxt is not None else -1,
        ("FAIL (expected, too big)" if (nxt is not None and not ok_nxt) else ("PASS (unexpected)" if nxt is not None else "N/A"))))
    print("TOTAL_TIME: %.2fs" % (time.monotonic() - t0))
    return 0


if __name__ == "__main__":
    try:
        code = main()
        sys.exit(0)
    except SystemExit:
        raise
    except Exception as e:
        # real bug: print and crash (non-zero) only for bugs, network failures already return 0
        print("BUG: unhandled exception %r" % e)
        import traceback
        traceback.print_exc()
        sys.exit(1)

