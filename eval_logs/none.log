# Generated by the network debugging agent
# Request: measure speed and packet loss from ns1 to ns2 with 1000 UDP packets
# TYPE: two-sided
# Re-run: python tool_builder.py --run tools/udp_speed_loss.py
#!/usr/bin/env python3
"""UDP speed + packet-loss test ns1 -> ns2 with 1000 packets."""
import argparse
import socket
import struct
import sys
import time

HEADER = struct.Struct("!II")  # seq, total
DEFAULT_HOST = "10.0.0.2"
DEFAULT_PORT = 5001
DEFAULT_COUNT = 1000
DEFAULT_SIZE = 1024  # total UDP payload bytes per packet
DEFAULT_INTERVAL = 0.001  # 1 ms pacing


def run_sender(host, port, count, size, interval):
    payload_len = max(0, size - HEADER.size)
    filler = b"X" * payload_len
    print(f"[sender] target={host}:{port} count={count} pkt_size={size} interval={interval}s", flush=True)
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.settimeout(5.0)
    sent = 0
    errors = 0
    first_err = ""
    start = time.monotonic()
    for seq in range(count):
        pkt = HEADER.pack(seq, count) + filler
        try:
            n = s.sendto(pkt, (host, port))
            if n == len(pkt):
                sent += 1
            else:
                errors += 1
        except OSError as e:
            errors += 1
            if not first_err:
                first_err = repr(e)
        if seq != count - 1:
            time.sleep(interval)
    end = time.monotonic()
    dur = end - start
    try:
        s.close()
    except OSError:
        pass
    total_bytes = sent * size
    mbps = (total_bytes * 8 / dur / 1e6) if dur > 0 else 0.0
    pps = (sent / dur) if dur > 0 else 0.0
    print(f"[sender] sent={sent}/{count} errors={errors}", flush=True)
    if first_err:
        print(f"[sender] first_send_error={first_err}", flush=True)
    print(f"[sender] duration_sec={dur:.3f} bytes={total_bytes} pps={pps:.1f} throughput_mbps={mbps:.3f}", flush=True)
    print(f"[sender] RAW: count={count} sent={sent} errors={errors} size={size} dur={dur:.4f}s bytes={total_bytes} mbps={mbps:.4f}", flush=True)
    if errors > 0 or sent != count:
        print("RESULT: FAIL sender could not send all packets", flush=True)
    else:
        print(f"RESULT: INFO sender done sent={sent} mbps={mbps:.3f} (see receiver for loss)", flush=True)


def run_receiver(host, port, expected, size):
    print(f"[receiver] bind={host}:{port} expected_count={expected}", flush=True)
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.settimeout(0.5)
    try:
        s.bind((host, port))
        print(f"[receiver] bound to {host}:{port}", flush=True)
    except OSError as e:
        # Fallback for local debugging; in ns2 the exact bind must work.
        print(f"[receiver] bind {host}:{port} failed: {e!r}, trying 0.0.0.0:{port}", flush=True)
        try:
            s.bind(("0.0.0.0", port))
            print(f"[receiver] bound to 0.0.0.0:{port}", flush=True)
        except OSError as e2:
            print(f"[receiver] fallback bind failed: {e2!r}", flush=True)
            print("RESULT: FAIL cannot bind", flush=True)
            try:
                s.close()
            except OSError:
                pass
            return

    received = set()
    total_seen = None
    mismatched_total = 0
    malformed = 0
    bytes_recv = 0
    first_t = None
    last_t = None
    start = time.monotonic()
    last_recv = None

    while True:
        now = time.monotonic()
        if last_recv is None:
            if now - start >= 10.0:
                print("[receiver] timeout: no packets in 10s", flush=True)
                break
        else:
            if now - last_recv >= 3.0:
                print("[receiver] idle 3s after last packet, finishing", flush=True)
                break
        if now - start >= 20.0:
            print("[receiver] overall 20s limit reached, finishing", flush=True)
            break
        try:
            data, addr = s.recvfrom(65535)
        except socket.timeout:
            continue
        except OSError as e:
            print(f"[receiver] recv error: {e!r}", flush=True)
            continue
        now2 = time.monotonic()
        if first_t is None:
            first_t = now2
        last_t = now2
        last_recv = now2
        bytes_recv += len(data)
        if len(data) < HEADER.size:
            malformed += 1
            continue
        try:
            seq, total = HEADER.unpack(data[:HEADER.size])
        except struct.error:
            malformed += 1
            continue
        if total_seen is None:
            total_seen = total
        elif total != total_seen:
            mismatched_total += 1
            if total > total_seen:
                total_seen = total
        # ignore out-of-range but still count bytes
        if 0 <= seq < 1000000:
            received.add(seq)
        else:
            malformed += 1

    try:
        s.close()
    except OSError:
        pass

    end_wall = time.monotonic()
    uniq = len(received)
    ref_total = total_seen if total_seen is not None else expected
    if total_seen is None:
        print(f"[receiver] received=0 (no packets, cannot confirm total; expected={expected})", flush=True)
        loss_pct = 100.0 if expected > 0 else 0.0
        print(f"[receiver] loss_pct=100.0 (assumed, expected={expected} got=0)", flush=True)
        print(f"[receiver] throughput_mbps=0.000 duration_sec=0.000 bytes=0", flush=True)
        print(f"[receiver] RAW: received=0 expected={expected} total_seen=UNKNOWN malformed={malformed} bytes={bytes_recv}", flush=True)
        print("RESULT: FAIL no packets received", flush=True)
        return

    missing = ref_total - uniq
    if missing < 0:
        missing = 0
    loss_pct = (missing / ref_total * 100.0) if ref_total > 0 else 0.0
    if first_t is not None and last_t is not None and last_t > first_t:
        dur = last_t - first_t
    else:
        dur = 0.0
    mbps = (bytes_recv * 8 / dur / 1e6) if dur > 0 else 0.0
    pps = (uniq / dur) if dur > 0 else float(uniq)
    # sorted check for raw evidence: min/max seq
    min_seq = min(received) if received else -1
    max_seq = max(received) if received else -1
    print(f"[receiver] packets_received={uniq}/{ref_total} missing={missing} loss_pct={loss_pct:.2f}%", flush=True)
    print(f"[receiver] bytes={bytes_recv} duration_sec={dur:.3f} pps={pps:.1f} throughput_mbps={mbps:.3f}", flush=True)
    print(f"[receiver] malformed={malformed} mismatched_total={mismatched_total} seq_min={min_seq} seq_max={max_seq}", flush=True)
    print(f"[receiver] RAW: received={uniq} total={ref_total} missing={missing} loss={loss_pct:.4f}% bytes={bytes_recv} dur={dur:.4f}s mbps={mbps:.4f} malformed={malformed}", flush=True)
    if loss_pct == 0.0:
        print("RESULT: PASS no loss", flush=True)
    elif loss_pct < 5.0:
        print(f"RESULT: DEGRADED loss {loss_pct:.2f}%", flush=True)
    else:
        print(f"RESULT: FAIL loss {loss_pct:.2f}%", flush=True)


def main():
    ap = argparse.ArgumentParser(description="UDP speed/loss ns1->ns2")
    ap.add_argument("--role", required=True, choices=["sender", "receiver"])
    ap.add_argument("--host", default=DEFAULT_HOST)
    ap.add_argument("--port", type=int, default=DEFAULT_PORT)
    ap.add_argument("--count", type=int, default=DEFAULT_COUNT)
    ap.add_argument("--size", type=int, default=DEFAULT_SIZE)
    ap.add_argument("--interval", type=float, default=DEFAULT_INTERVAL)
    args = ap.parse_args()
    if args.role == "sender":
        try:
            run_sender(args.host, args.port, args.count, args.size, args.interval)
        except OSError as e:
            print(f"[sender] network error: {e!r}", flush=True)
            print("RESULT: FAIL network error", flush=True)
    else:
        try:
            run_receiver(args.host, args.port, args.count, args.size)
        except OSError as e:
            print(f"[receiver] network error: {e!r}", flush=True)
            print("RESULT: FAIL network error", flush=True)


if __name__ == "__main__":
    main()

