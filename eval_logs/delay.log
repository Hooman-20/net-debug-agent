# Generated by the network debugging agent
# Request: measure latency and jitter from ns1 to ns2
# TYPE: one-sided
# Re-run: python tool_builder.py --run tools/latency_jitter.py
#!/usr/bin/env python3
"""One-sided latency + jitter test from ns1 to ns2 using ping."""
import re
import statistics
import subprocess
import sys
import time

TARGET = "10.0.0.2"
COUNT = 10
INTERVAL = "0.2"
PER_PACKET_TIMEOUT = "1"
DEADLINE = "15"
SUBPROCESS_TIMEOUT = 18


def parse_rtts(output):
    """Return list of per-packet RTTs in ms from ping output."""
    return [float(x) for x in re.findall(r"time=([0-9.]+)\s*ms", output)]


def parse_summary(output):
    tx = rx = loss = None
    m = re.search(r"(\d+)\s+packets transmitted,\s*(\d+)\s*(?:packets\s*)?received.*?(\d+)% packet loss", output)
    if m:
        tx = int(m.group(1))
        rx = int(m.group(2))
        loss = int(m.group(3))
    rtt = None
    m2 = re.search(r"rtt min/avg/max/mdev\s*=\s*([0-9.]+)/([0-9.]+)/([0-9.]+)/([0-9.]+)\s*ms", output)
    if m2:
        rtt = tuple(float(g) for g in m2.groups())
    return tx, rx, loss, rtt


def main():
    print(f"TARGET: {TARGET} (ns2 peer, directly connected)")
    print(f"CONFIG: ping -c {COUNT} -i {INTERVAL} -W {PER_PACKET_TIMEOUT} -w {DEADLINE} {TARGET}")
    print(f"START_TIME: {time.strftime('%Y-%m-%dT%H:%M:%S')}")

    cmd = ["ping", "-c", str(COUNT), "-i", INTERVAL, "-W", PER_PACKET_TIMEOUT, "-w", DEADLINE, TARGET]
    t0 = time.monotonic()
    proc = None
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True, timeout=SUBPROCESS_TIMEOUT)
        elapsed = time.monotonic() - t0
        combined = (proc.stdout or "") + (proc.stderr or "")
    except subprocess.TimeoutExpired as e:
        elapsed = time.monotonic() - t0
        combined = ""
        if e.stdout:
            combined += e.stdout.decode() if isinstance(e.stdout, bytes) else str(e.stdout)
        if e.stderr:
            combined += e.stderr.decode() if isinstance(e.stderr, bytes) else str(e.stderr)
        print(f"RESULT: status=FAIL reason=subprocess_timeout elapsed_s={elapsed:.2f}")
        print("--- RAW ping output (timeout) ---")
        print(combined.strip() if combined.strip() else "(no output before timeout)")
        print("--- END RAW ---")
        print(f"ELAPSED_S: {elapsed:.2f}")
        sys.exit(0)
    except FileNotFoundError as e:
        elapsed = time.monotonic() - t0
        print(f"RESULT: status=ERROR reason=ping_not_found detail={e}")
        print(f"ELAPSED_S: {elapsed:.2f}")
        sys.exit(0)
    except OSError as e:
        elapsed = time.monotonic() - t0
        print(f"RESULT: status=ERROR reason=os_error detail={e}")
        print(f"ELAPSED_S: {elapsed:.2f}")
        sys.exit(0)

    print(f"EXIT_CODE: {proc.returncode}")
    print(f"ELAPSED_S: {elapsed:.2f}")
    print("--- RAW ping output ---")
    raw = combined.strip()
    print(raw if raw else "(empty ping output)")
    print("--- END RAW ---")

    tx, rx, loss, rtt_summary = parse_summary(combined)
    rtts = parse_rtts(combined)

    if tx is not None:
        print(f"RESULT: packets_transmitted={tx}")
    else:
        print("RESULT: packets_transmitted=unknown")
    if rx is not None:
        print(f"RESULT: packets_received={rx}")
    else:
        print(f"RESULT: packets_received=unknown (parsed_samples={len(rtts)})")
    if loss is not None:
        print(f"RESULT: packet_loss_percent={loss}%")
    if rtt_summary is not None:
        print(f"RESULT: ping_rtt_min_ms={rtt_summary[0]:.3f}")
        print(f"RESULT: ping_rtt_avg_ms={rtt_summary[1]:.3f}")
        print(f"RESULT: ping_rtt_max_ms={rtt_summary[2]:.3f}")
        print(f"RESULT: ping_rtt_mdev_ms={rtt_summary[3]:.3f}")

    print(f"EVIDENCE: samples_count={len(rtts)}")
    if rtts:
        print("EVIDENCE: rtt_samples_ms=" + ",".join(f"{v:.3f}" for v in rtts))
        mn = min(rtts)
        mx = max(rtts)
        avg = sum(rtts) / len(rtts)
        print(f"RESULT: rtt_min_ms={mn:.3f}")
        print(f"RESULT: rtt_avg_ms={avg:.3f}")
        print(f"RESULT: rtt_max_ms={mx:.3f}")
        if len(rtts) >= 2:
            diffs = [abs(rtts[i] - rtts[i - 1]) for i in range(1, len(rtts))]
            j_avg = sum(diffs) / len(diffs)
            j_max = max(diffs)
            print(f"RESULT: jitter_avg_ms={j_avg:.3f} (mean abs diff of successive RTTs)")
            print(f"RESULT: jitter_max_ms={j_max:.3f} (max abs diff of successive RTTs)")
            print("EVIDENCE: successive_diffs_ms=" + ",".join(f"{v:.3f}" for v in diffs))
            if len(rtts) >= 3:
                try:
                    stdev = statistics.stdev(rtts)
                except statistics.StatisticsError:
                    stdev = 0.0
                pstdev = statistics.pstdev(rtts)
                print(f"RESULT: rtt_stdev_ms={stdev:.3f}")
                print(f"RESULT: rtt_pstdev_ms={pstdev:.3f}")
            else:
                print("RESULT: rtt_stdev_ms=n/a (need >=3 samples)")
        else:
            print("RESULT: jitter_avg_ms=n/a (need >=2 samples)")
            print("RESULT: jitter_max_ms=n/a (need >=2 samples)")
    else:
        print("RESULT: rtt_min_ms=n/a")
        print("RESULT: rtt_avg_ms=n/a")
        print("RESULT: rtt_max_ms=n/a")
        print("RESULT: jitter_avg_ms=n/a")
        print("RESULT: jitter_max_ms=n/a")

    # Status: PASS only if configured path worked
    if rx is not None and rx > 0 and rtts:
        if loss == 0:
            print("STATUS: PASS (peer reachable, no loss)")
        else:
            print(f"STATUS: DEGRADED (peer reachable with {loss}% loss)")
    elif proc.returncode == 0 and rtts:
        print("STATUS: PASS (peer reachable)")
    else:
        print("STATUS: FAIL (peer unreachable or no RTT samples via configured path)")

    sys.exit(0)


if __name__ == "__main__":
    main()

