# Generated by the network debugging agent
# Request: measure speed and packet loss from ns1 to ns2 with 1000 UDP packets
# TYPE: two-sided
# Re-run: python tool_builder.py --run tools/udp_speed_loss_3.py
#!/usr/bin/env python3
"""UDP speed + packet-loss test, ns1 -> ns2, 1000 packets."""
import argparse
import socket
import sys
import time

RECEIVER_IP = "10.0.0.2"
PORT = 5001
TOTAL_PACKETS = 1000
DATAGRAM_SIZE = 1400  # total bytes per UDP datagram
PACING_SEC = 0.001  # ~1 ms between packets
RECV_TIMEOUT = 1.0  # socket timeout for receiver loop
IDLE_EXIT_NO_DATA = 10.0  # exit if nothing arrives in 10 s
IDLE_EXIT_AFTER_DATA = 3.0  # exit 3 s after last packet
ABSOLUTE_MAX = 20.0  # hard cap to stay under 25 s run


def build_packet(seq, total, size=DATAGRAM_SIZE):
    header = f"{seq:04d}/{total:04d}:".encode("ascii")
    if len(header) >= size:
        return header[:size]
    return header + b"X" * (size - len(header))


def parse_packet(data):
    # returns (seq, total) or raises ValueError
    head, _, _ = data.partition(b":")
    s_seq, _, s_total = head.partition(b"/")
    seq = int(s_seq.decode("ascii"))
    total = int(s_total.decode("ascii"))
    return seq, total


def run_receiver():
    print(f"[RECEIVER] listening on {RECEIVER_IP}:{PORT}, "
          f"expecting {TOTAL_PACKETS} packets", flush=True)
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.settimeout(RECV_TIMEOUT)
    try:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_RCVBUF, 4 * 1024 * 1024)
    except OSError:
        pass
    try:
        sock.bind((RECEIVER_IP, PORT))
        print(f"[RECEIVER] bound to {RECEIVER_IP}:{PORT}", flush=True)
    except OSError as e:
        print(f"[RECEIVER] bind {RECEIVER_IP}:{PORT} failed: {e}; "
              f"trying 0.0.0.0:{PORT}", flush=True)
        try:
            sock.bind(("0.0.0.0", PORT))
            print(f"[RECEIVER] bound to 0.0.0.0:{PORT} (fallback)", flush=True)
        except OSError as e2:
            print(f"[RECEIVER] RESULT: FAIL bind failed: {e2}", flush=True)
            print(f"[RECEIVER] EVIDENCE: bind_error={e2!r}", flush=True)
            sock.close()
            return

    start = time.monotonic()
    first = None
    last = None
    received = set()
    bytes_rx = 0
    expected = None
    malformed = 0
    count_rx = 0

    while True:
        try:
            data, addr = sock.recvfrom(65535)
        except socket.timeout:
            now = time.monotonic()
            if first is None:
                if now - start >= IDLE_EXIT_NO_DATA:
                    print("[RECEIVER] timeout: no packets in "
                          f"{IDLE_EXIT_NO_DATA}s, exiting", flush=True)
                    break
                if now - start >= ABSOLUTE_MAX:
                    break
                continue
            else:
                if now - last >= IDLE_EXIT_AFTER_DATA:
                    print("[RECEIVER] idle: 3s since last packet, exiting",
                          flush=True)
                    break
                if now - start >= ABSOLUTE_MAX:
                    print("[RECEIVER] absolute timeout, exiting", flush=True)
                    break
                continue
        except OSError as e:
            print(f"[RECEIVER] recv error: {e!r}", flush=True)
            break

        now = time.monotonic()
        if first is None:
            first = now
        last = now
        count_rx += 1
        bytes_rx += len(data)
        try:
            seq, total = parse_packet(data)
        except Exception:
            malformed += 1
            continue
        if expected is None:
            expected = total
        # only track seqs in range to avoid garbage inflating set
        if 0 <= seq < 100000:
            received.add(seq)

    sock.close()
    end = time.monotonic()
    if expected is None:
        expected = TOTAL_PACKETS
    uniq = len(received)
    lost = max(0, expected - uniq)
    loss_pct = (lost / expected * 100.0) if expected > 0 else 0.0
    if first is not None and last is not None and last > first:
        dur = last - first
    else:
        dur = 0.0
    bps = (bytes_rx * 8 / dur) if dur > 0 else 0.0
    mbps = bps / 1e6
    wall = end - start

    print(f"[RECEIVER] RESULT: received {uniq}/{expected} packets, "
          f"lost {lost} ({loss_pct:.2f}%), "
          f"throughput {mbps:.3f} Mbps ({bps:.1f} bps)", flush=True)
    print(f"[RECEIVER] EVIDENCE: raw_recv_calls={count_rx} "
          f"unique={uniq} expected={expected} malformed={malformed} "
          f"bytes={bytes_rx} recv_window={dur:.4f}s wall={wall:.4f}s "
          f"first={first} last={last}", flush=True)
    if uniq > 0:
        missing = sorted(set(range(expected)) - received)[:20]
        print(f"[RECEIVER] EVIDENCE: missing_sample={missing} "
              f"total_missing={lost}", flush=True)
    else:
        print("[RECEIVER] EVIDENCE: missing_sample=all packets missing",
              flush=True)


def run_sender():
    print(f"[SENDER] target {RECEIVER_IP}:{PORT}, "
          f"sending {TOTAL_PACKETS} packets size {DATAGRAM_SIZE}B "
          f"pacing {PACING_SEC * 1000:.1f}ms", flush=True)
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.settimeout(2.0)
    sent = 0
    bytes_tx = 0
    send_err = None
    start = time.monotonic()
    for seq in range(TOTAL_PACKETS):
        pkt = build_packet(seq, TOTAL_PACKETS)
        try:
            n = sock.sendto(pkt, (RECEIVER_IP, PORT))
            sent += 1
            bytes_tx += n
        except OSError as e:
            send_err = e
            print(f"[SENDER] sendto failed at seq {seq}: {e!r}", flush=True)
            break
        # pace to avoid receiver buffer overflow mistaken for loss
        try:
            time.sleep(PACING_SEC)
        except Exception:
            pass
    end = time.monotonic()
    sock.close()
    dur = end - start
    bps = (bytes_tx * 8 / dur) if dur > 0 else 0.0
    mbps = bps / 1e6

    print(f"[SENDER] RESULT: sent {sent}/{TOTAL_PACKETS} packets, "
          f"{bytes_tx} bytes in {dur:.4f}s, "
          f"send_rate {mbps:.3f} Mbps ({bps:.1f} bps)", flush=True)
    print(f"[SENDER] EVIDENCE: sent={sent} expected={TOTAL_PACKETS} "
          f"bytes={bytes_tx} pkt_size={DATAGRAM_SIZE} "
          f"duration={dur:.4f}s pacing={PACING_SEC}s "
          f"error={send_err!r}", flush=True)


def main():
    ap = argparse.ArgumentParser(description="UDP speed/loss test")
    ap.add_argument("--role", required=True, choices=["sender", "receiver"])
    args = ap.parse_args()
    try:
        if args.role == "receiver":
            run_receiver()
        else:
            run_sender()
    except OSError as e:
        # network failure is a valid test outcome, not a crash
        print(f"[{args.role.upper()}] RESULT: network error {e!r}", flush=True)
        print(f"[{args.role.upper()}] EVIDENCE: OSError={e!r}", flush=True)
    sys.exit(0)


if __name__ == "__main__":
    main()

