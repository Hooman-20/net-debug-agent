# Generated by the network debugging agent
# Request: check if DNS resolution works for web.lab
# TYPE: one-sided
# Re-run: python tool_builder.py --run tools/dns_web_lab.py
#!/usr/bin/env python3
"""One-sided DNS resolution test for web.lab using system-configured resolver."""
import concurrent.futures
import socket
import subprocess
import sys
import time
import os

TARGET = "web.lab"
GAI_TIMEOUT = 5.0
DIG_TIMEOUT = 6.0  # subprocess timeout
DIG_QTIME = "4"    # dig +time per query


def read_file(path):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as f:
            return f.read()
    except Exception as e:
        return f"<could not read {path}: {e}>"


def gai_with_timeout(host, timeout):
    """socket.getaddrinfo with timeout via thread. Returns (ok, result_or_error, elapsed)."""
    start = time.monotonic()
    with concurrent.futures.ThreadPoolExecutor(max_workers=1) as ex:
        fut = ex.submit(socket.getaddrinfo, host, None,
                        family=socket.AF_UNSPEC, type=socket.SOCK_STREAM)
        try:
            res = fut.result(timeout=timeout)
            elapsed = time.monotonic() - start
            return True, res, elapsed, None
        except concurrent.futures.TimeoutError as e:
            elapsed = time.monotonic() - start
            # cancel best-effort; thread may still block briefly
            fut.cancel()
            return False, None, elapsed, f"timeout after {timeout}s: {e}"
        except socket.gaierror as e:
            elapsed = time.monotonic() - start
            return False, None, elapsed, f"gaierror: {e}"
        except Exception as e:
            elapsed = time.monotonic() - start
            return False, None, elapsed, f"{type(e).__name__}: {e}"


def run_cmd(args, timeout):
    """Run command with arg list, no shell. Returns dict with rc/stdout/stderr/elapsed/error."""
    start = time.monotonic()
    try:
        p = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
        elapsed = time.monotonic() - start
        return {"ok": True, "rc": p.returncode, "stdout": p.stdout,
                "stderr": p.stderr, "elapsed": elapsed, "error": None}
    except subprocess.TimeoutExpired as e:
        elapsed = time.monotonic() - start
        out = e.stdout.decode() if isinstance(e.stdout, bytes) else (e.stdout or "")
        err = e.stderr.decode() if isinstance(e.stderr, bytes) else (e.stderr or "")
        return {"ok": False, "rc": None, "stdout": out, "stderr": err,
                "elapsed": elapsed, "error": f"timeout after {timeout}s"}
    except FileNotFoundError as e:
        elapsed = time.monotonic() - start
        return {"ok": False, "rc": None, "stdout": "", "stderr": "",
                "elapsed": elapsed, "error": f"not found: {e}"}
    except Exception as e:
        elapsed = time.monotonic() - start
        return {"ok": False, "rc": None, "stdout": "", "stderr": "",
                "elapsed": elapsed, "error": f"{type(e).__name__}: {e}"}


def main():
    print(f"=== DNS resolution test: {TARGET} (one-sided, ns1) ===")
    print(f"Target: {TARGET}")

    resolv = read_file("/etc/resolv.conf")
    hosts = read_file("/etc/hosts")
    nsswitch = read_file("/etc/nsswitch.conf")

    print("\n--- Configured resolver (/etc/resolv.conf) ---")
    print(resolv.strip() if resolv.strip() else "<empty>")
    print("\n--- /etc/hosts (to detect shadowing) ---")
    print(hosts.strip() if hosts.strip() else "<empty>")

    hosts_has_target = False
    for line in hosts.splitlines():
        s = line.strip()
        if not s or s.startswith("#"):
            continue
        # crude check: target appears as a hostname token
        parts = s.split()
        if TARGET in parts[1:]:
            hosts_has_target = True
            break
    if hosts_has_target:
        print(f"\n[NOTE] {TARGET} found in /etc/hosts: getaddrinfo success alone does NOT prove DNS works; dig result is decisive.")
    else:
        print(f"\n[NOTE] {TARGET} not seen in /etc/hosts.")

    # 1) System resolver via getaddrinfo (uses nsswitch + resolv.conf as configured)
    print("\n--- Test 1: system resolver via socket.getaddrinfo ---")
    gai_ok, gai_res, gai_dt, gai_err = gai_with_timeout(TARGET, GAI_TIMEOUT)
    if gai_ok:
        print(f"[TEST1] getaddrinfo: SUCCESS in {gai_dt:.3f}s (timeout {GAI_TIMEOUT}s)")
        addrs = []
        for fam, typ, proto, canon, sockaddr in gai_res:
            ip = sockaddr[0] if sockaddr else "?"
            famname = "AF_INET6" if fam == socket.AF_INET6 else ("AF_INET" if fam == socket.AF_INET else str(fam))
            addrs.append(f"{famname} {ip}")
            print(f"  raw getaddrinfo: family={famname} sockaddr={sockaddr}")
        uniq = sorted(set(addrs))
        print(f"  count: {len(gai_res)} entries, unique: {uniq}")
    else:
        print(f"[TEST1] getaddrinfo: FAIL in {gai_dt:.3f}s (timeout {GAI_TIMEOUT}s)")
        print(f"  raw error: {gai_err}")

    # 2) dig using configured resolver (no @server hardcoded)
    print("\n--- Test 2: dig via configured resolver (no @server) ---")
    dig_full = run_cmd(["dig", "+time=" + DIG_QTIME, "+tries=1", TARGET], timeout=DIG_TIMEOUT)
    print(f"[TEST2a] dig full: subprocess_ok={dig_full['ok']} rc={dig_full['rc']} elapsed={dig_full['elapsed']:.3f}s timeout={DIG_TIMEOUT}s")
    if dig_full["error"]:
        print(f"  raw error: {dig_full['error']}")
    print("  raw stdout:")
    print(dig_full["stdout"].strip() if dig_full["stdout"].strip() else "  <empty stdout>")
    print("  raw stderr:")
    print(dig_full["stderr"].strip() if dig_full["stderr"].strip() else "  <empty stderr>")

    dig_short = run_cmd(["dig", "+short", "+time=" + DIG_QTIME, "+tries=1", TARGET], timeout=DIG_TIMEOUT)
    print(f"\n[TEST2b] dig +short: subprocess_ok={dig_short['ok']} rc={dig_short['rc']} elapsed={dig_short['elapsed']:.3f}s")
    if dig_short["error"]:
        print(f"  raw error: {dig_short['error']}")
    short_lines = [l.strip() for l in (dig_short["stdout"] or "").splitlines() if l.strip()]
    print(f"  raw +short lines ({len(short_lines)}): {short_lines if short_lines else '<none>'}")
    if dig_short["stderr"] and dig_short["stderr"].strip():
        print(f"  raw +short stderr: {dig_short['stderr'].strip()}")

    # Evaluate dig success: +short non-empty means an answer was returned via DNS.
    # Also check full output for status NOERROR and ANSWER count >0 as supporting evidence.
    dig_ok = len(short_lines) > 0
    full_out = dig_full["stdout"] or ""
    has_noerror = "status: NOERROR" in full_out
    print(f"\n  dig evidence: +short_nonempty={dig_ok} full_has_NOERROR={has_noerror}")
    # Show status/answer lines explicitly
    for line in full_out.splitlines():
        ls = line.strip()
        if "status:" in ls or ls.startswith(";; flags") or "ANSWER:" in ls or "AUTHORITY:" in ls:
            print(f"  dig summary line: {ls}")

    # Final verdict: DNS works only if dig (real DNS path) AND system resolver both succeed.
    print("\n--- Verdict ---")
    print(f"system resolver (getaddrinfo): {'SUCCESS' if gai_ok else 'FAIL'}")
    print(f"DNS via dig (configured resolver): {'SUCCESS' if dig_ok else 'FAIL'}")
    if gai_ok and dig_ok:
        print(f"[RESULT] PASS: {TARGET} resolves via configured DNS path.")
    else:
        print(f"[RESULT] FAIL: {TARGET} does NOT resolve via configured DNS path.")
        if hosts_has_target and gai_ok and not dig_ok:
            print("  detail: /etc/hosts provides a name but DNS (dig) returned no answer -> DNS FAIL.")
        if not gai_ok and dig_ok:
            print("  detail: dig got an answer but getaddrinfo failed -> system resolver path FAIL.")
        if not gai_ok and not dig_ok:
            print("  detail: both paths failed.")

    print(f"\nTimings: getaddrinfo {gai_dt:.3f}s, dig-full {dig_full['elapsed']:.3f}s, dig-short {dig_short['elapsed']:.3f}s")
    sys.exit(0)


if __name__ == "__main__":
    main()

